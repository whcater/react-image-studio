{
  "name": "react-image-studio",
  "version": "1.1.0",
  "description": "A feature-rich, non-destructive image editor component for React (crop, rotate, filters, brush, text, zoom and export).",
  "keywords": [
    "react",
    "image",
    "editor",
    "image-editor",
    "canvas",
    "crop",
    "filters",
    "photo",
    "typescript",
    "component"
  ],
  "license": "MIT",
  "author": "whcater",
  "repository": {
    "type": "git",
    "url": "git://github.com/whcater/react-image-studio.git"
  },
  "homepage": "https://github.com/whcater/react-image-studio#readme",
  "bugs": {
    "url": "https://github.com/whcater/react-image-studio/issues"
  },
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./auto-style": {
      "types": "./dist/auto-style.d.ts",
      "import": "./dist/auto-style.mjs",
      "require": "./dist/auto-style.cjs"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "clean": "node ./scripts/clean.mjs",
    "build": "node ./scripts/build.mjs",
    "build:site": "node ./scripts/build-site.mjs",
    "prepublishOnly": "npm run clean && npm run build && npm test",
    "test": "node ./scripts/test.mjs",
    "typecheck": "tsc -p tsconfig.check.json --noEmit"
  },
  "peerDependencies": {
    "react": ">=17",
    "react-dom": ">=17"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=18"
  }
}
